#!/bin/bash
set -eu

# Optional administrator-owned configuration.
if [ -f /etc/default/tv-dashboard ]; then
    . /etc/default/tv-dashboard
fi

TV_USER=${TV_USER:-steve}

if [ "$TV_USER" = root ]; then
    echo "Choose a regular dashboard user, not root." >&2
    exit 1
fi

account=$(getent passwd "$TV_USER") || {
    echo "Unknown dashboard user: $TV_USER" >&2
    exit 1
}

TV_HOME=$(printf '%s\n' "$account" | cut -d: -f6)
cd "$TV_HOME"

as_user() {
    /usr/sbin/runuser -u "$TV_USER" -- \
        /usr/bin/env -u TMUX \
        HOME="$TV_HOME" TERM=linux TZ=Australia/Sydney "$@"
}

# Create the dashboard if it does not already exist.
if ! as_user /usr/bin/tmux -L tv has-session -t '=tv' 2>/dev/null; then
    if ! as_user /usr/bin/tmux -L tv list-sessions >/dev/null 2>&1; then
        as_user /usr/bin/tmux -L tv -f /dev/null \
            new-session -d -s __tv_startup -x 240 -y 67
    fi

    as_user /usr/bin/tmux -L tv \
        source-file "$TV_HOME/.config/tv.conf"

    as_user /usr/bin/tmux -L tv has-session -t '=tv'

    as_user /usr/bin/tmux -L tv \
        kill-session -t '=__tv_startup' 2>/dev/null || true
fi

# Detach the previous viewer.
as_user /usr/bin/tmux -L tv \
    detach-client -s '=tv' 2>/dev/null || true

# Show the dashboard on console 8.
exec /usr/bin/openvt -f -c 8 -s -w -- \
    /usr/sbin/runuser -u "$TV_USER" -- \
    /usr/bin/env -u TMUX \
    HOME="$TV_HOME" TERM=linux TZ=Australia/Sydney \
    /bin/bash -c '
        setterm --blank 0 --powersave off --powerdown 0 2>/dev/null || true
        exec /usr/bin/tmux -L tv attach-session -t tv
    '
