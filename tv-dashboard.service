[Unit]
Description=TV tmux dashboard on console 8
After=systemd-user-sessions.service getty@tty8.service
Conflicts=getty@tty8.service

[Service]
Type=simple
Environment=TZ=Australia/Sydney
ExecStart=/usr/local/bin/tv-dashboard-start
Restart=always
RestartSec=10
TimeoutStopSec=10

# On stop, stop the display
ExecStopPost=/usr/bin/chvt 8
ExecStopPost=/bin/sh -c 'TERM=linux /usr/bin/setterm --clear all --cursor off > /dev/tty8'

[Install]
WantedBy=multi-user.target
